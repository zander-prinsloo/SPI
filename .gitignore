########################################################################
#
# .gitignore DIME template
# https://github.com/worldbank/DIMEwiki/tree/master/Topics/GitHub
#
# We recommend that you create a .gitignore file using GitHub's tools and
# replace the content of that file with the content of this file. Otherwise
# you have to rename this file .gitignore. But if you rename the fine in a
# regular folder window PCs and Macs are likely to keep the file extension
# so that the file ends up being names .gitignore.txt. Code editors like, Atom,
# can edit the file extension, but if you are not familiar with how to do that,
# we recommend that you generate an ignore file using GitHub and simply replace
# the content of that file.
#
# Note that if you are using GitKraken you need to use version 5.x or more
# recent for this template to work properly
#
########################################################################

#######################
# Start by ignoring everything, and below we are explicitly saying
# what to not ignore
*

#######################
# List of files with GitHub functionality anywhere in the repo
# that we do not want to ignore

# These files include GitHub settings
!.gitignore
!.gitattributes
!*.nojekyll
# Keep markdown files used for documentation on GitHub
!README.md
!CONTRIBUTING.md
!LICENSE.md

#######################
# For performance reasons, if a folder is already ignored, then
# GitHub does not check the content for that folder for matches
# with additional rules. The line below includes folder in the
# top folder (but not their content), so that anything matching
# the rules below will still not be ignored.
!*/

#######################
# The following file types are code that should always be
# included no matter where in the repository folder they are
# located unless you explicitly ignore that folder

# Stata
!/**/**/*.do
!/**/**/*.ado
!/**/**/*.sthlp
!/**/**/*_adoprogram/*.toc
!/**/**/*_adoprogram/*.pkg

# R-scrips and Rmarkdown-scripts
!/**/**/*.R
!/**/**/*.Rproj
!/**/**/*.Rmd
!/**/**/*.qmd
!renv*
!renv.lock
!renv/settings.json
!.Rprofile
!/**/**/*.Rdata


# HTML files
!/**/**/*.html
!/**/**/*.css


# LaTeX
!/**/**/*.tex
!/**/**/*.bib

# Python
!/**/**/*.py
!/**/**/*.ipynb

# Matlab
!/**/**/*.m

# Markdown
!/**/**/*.md

# JSON (e.g. the fixtures hash manifest)
!/**/**/*.json

# xlsx files
!/**/**/*.xlsx

# Excel lock files (created while a workbook is open)
~$*.xlsx
~$*.xls

# csv files
!/**/**/*.csv
!/**/**/*.fst

# Collection raw/provenance artifacts and run reports
!01_raw_data/_collection/
!01_raw_data/_collection/**
!01_raw_data/1.5_DUIO/raw/
!01_raw_data/1.5_DUIO/raw/**
!01_raw_data/3_DP/sdg_data/raw/
!01_raw_data/3_DP/sdg_data/raw/**

# png files
!/02_programs/*.png

# stata files
!/R/**/*outputs/*.dta

#Powerpoint files
!/**/**/*.ppt
!/**/**/*.pptx

#word

#PNG files in the reports folder
!/04_reports/*.png
!/04_reports/*.PNG

#Country reports
!/country_reports/*.docx

#######################
# Include all the files with passwords or tokens here. All files named
# password or passwords are with this template ignored no matter which
# format you are using. Additionally, all content in any folder called
# password or passwords are also ignored. NOTE that your project might be
# using different names and then you must edit the lines below accordingly.
password.*
passwords.*
password/
passwords/
# Credential files (defense-in-depth)
.env
.env.*
.Renviron
*.pem
*.key
.Rproj.user

# Compound GPID project/tool documentation is local tooling, not SPI source.
compound-gpid.md

# SPI pipeline: staging outputs are transient and must not be committed
# The root folder is a legacy cache. Active candidates use
# 03_output_data/.candidate/ and validated sets are promoted automatically.
staging/
_targets/

# Repository-local working sandboxes contain copied code and raw-data symlinks.
# Retained run outputs remain available under replication/spi-rep/.
/replication/.scratch/

# Recovered bulk downloads, historical runs and scratch helpers stay local.
# Version the 202611 review CSVs and their supporting evidence explicitly.
/replication/external-logs/
/replication/jmp-probe/
/replication/oecd-probe/
/replication/r-session-artifacts/
/replication/spi-gate/
/replication/spi-rep/*
!/replication/spi-rep/preview-p0p1/
/replication/spi-rep/preview-p0p1/*
!/replication/spi-rep/preview-p0p1/SPI_data.csv
!/replication/spi-rep/preview-p0p1/SPI_index.csv
!/replication/spi-rep/preview-p0p1/PROVISIONAL_ODIN.md
!/replication/spi-rep/preview-p0p1/_estimation_manifest.json
!/replication/spi-rep/preview-p0p1/revision_*.csv
!/replication/spi-rep/preview-p0p1/revision_summary_2025.md
!/replication/spi-rep/preview-p0p1/vintage_diff_2025.csv
!/replication/spi-rep/preview-p0p1/vintage_diff_2025.md

# SPI internal update notes (contains internal SharePoint links and team notes)
/SPI updates.xlsx

# Compound GPID managed items (junctions + copied file - do not commit)
.agents/AGENTS.md
.agents/commands
.agents/instructions
.agents/shared
.agents/skills
.agents/subagents
.claude/CLAUDE.md
.claude/agents
.claude/commands
.claude/instructions
.claude/shared
.claude/skills
.compound-gpid/managed-files.json
.github/agents
.github/copilot-instructions.md
.github/instructions
.github/prompts
.github/shared
.github/skills
.kilo/AGENTS.md
.kilo/agents
.kilo/commands
.kilo/instructions
.kilo/kilo.json
.kilo/shared
.kilo/skills
.opencode/AGENTS.md
.opencode/agents
.opencode/commands
.opencode/instructions
.opencode/opencode.json
.opencode/shared
.opencode/skills

# Oversized 2025 manual IGME input remains local; other vintages stay tracked.
/01_raw_data/1.5_DUIO/UN IGME 2025.csv
